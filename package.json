{
  "name": "chengpeiquan.com",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-s dev:*",
    "dev:cache": "pnpm run build:cache",
    "dev:thumb-hash": "pnpm run build:thumb-hash",
    "dev:search": "pnpm run build:search",
    "dev:app": "next dev --webpack -p 4832",
    "build": "run-s build:*",
    "build:cache": "tsx ./scripts/generate-cache.ts",
    "build:thumb-hash": "tsx ./scripts/generate-thumb-hash.ts",
    "build:search": "tsx ./scripts/generate-search-index.ts",
    "build:app": "next build --webpack",
    "build:copy-assets": "tsx ./scripts/copy-assets.ts",
    "preview": "docker-compose build && docker-compose up -d",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "pnpm exec eslint .",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "format:prettier": "prettier --write .",
    "backup": "git add . && git commit -m \"chore: backup\" && git push",
    "deps:check": "pnpm exec taze major",
    "deps:up": "pnpm exec taze -w -i",
    "prepare": "husky"
  },
  "dependencies": {
    "@bassist/utils": "^0.17.0",
    "@blackwork/docs": "^0.6.0",
    "@blackwork/machine": "^0.2.2",
    "@blackwork/search": "^0.1.1",
    "@re-dev/react-truncate": "^0.6.0",
    "@web-analytics/core": "^0.1.5",
    "blackwork": "^0.13.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "next-intl": "^4.13.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-forage": "^0.2.2",
    "react-ga4": "^3.0.1",
    "thumbhash": "^0.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bassist/eslint-config": "^0.5.0",
    "@bassist/node-utils": "^0.5.0",
    "@bassist/oxc-integration": "^0.2.0",
    "@bassist/tsconfig": "^0.1.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@shikijs/rehype": "^4.4.3",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.8.1",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "rehype-unwrap-images": "^1.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "taze": "^21.1.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxfmt --write",
      "oxlint --fix",
      "pnpm exec eslint --fix"
    ]
  },
  "packageManager": "pnpm@11.21.0"
}
